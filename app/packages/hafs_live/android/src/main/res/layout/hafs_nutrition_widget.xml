<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/hafs_food_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="@drawable/hafs_nutrition_widget_bg">

    <TextView
        android:id="@+id/hafs_food_kicker"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="11sp"
        android:textAllCaps="true"
        android:textColor="#A5D6A7"
        android:maxLines="1" />

    <TextView
        android:id="@+id/hafs_food_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:maxLines="1"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/hafs_food_lines"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="2dp"
        android:textSize="13sp"
        android:textColor="#E0E0E0"
        android:maxLines="2"
        android:ellipsize="end" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/hafs_food_scan"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:gravity="center"
            android:text="▦"
            android:textSize="18sp"
            android:textColor="#FFFFFF"
            android:background="@drawable/hafs_live_button" />

        <TextView
            android:id="@+id/hafs_food_add"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="+"
            android:textSize="22sp"
            android:textColor="#FFFFFF"
            android:background="@drawable/hafs_live_button_main" />
    </LinearLayout>
</LinearLayout>
