<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="10dp"
    android:paddingEnd="16dp"
    android:paddingBottom="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/hafs_title"
            style="@android:style/TextAppearance.Material.Notification.Title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1" />

        <Chronometer
            android:id="@+id/hafs_rest"
            style="@android:style/TextAppearance.Material.Notification.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:visibility="gone" />
    </LinearLayout>

    <TextView
        android:id="@+id/hafs_subtitle"
        style="@android:style/TextAppearance.Material.Notification"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/hafs_weight_group"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/hafs_weight_minus"
                style="@android:style/TextAppearance.Material.Notification.Title"
                android:layout_width="44dp"
                android:layout_height="40dp"
                android:background="@drawable/hafs_live_button"
                android:gravity="center"
                android:text="−" />

            <TextView
                android:id="@+id/hafs_weight"
                style="@android:style/TextAppearance.Material.Notification.Title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:maxLines="1" />

            <TextView
                android:id="@+id/hafs_weight_plus"
                style="@android:style/TextAppearance.Material.Notification.Title"
                android:layout_width="44dp"
                android:layout_height="40dp"
                android:background="@drawable/hafs_live_button"
                android:gravity="center"
                android:text="+" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/hafs_reps_group"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/hafs_reps_minus"
                style="@android:style/TextAppearance.Material.Notification.Title"
                android:layout_width="44dp"
                android:layout_height="40dp"
                android:background="@drawable/hafs_live_button"
                android:gravity="center"
                android:text="−" />

            <TextView
                android:id="@+id/hafs_reps"
                style="@android:style/TextAppearance.Material.Notification.Title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:maxLines="1" />

            <TextView
                android:id="@+id/hafs_reps_plus"
                style="@android:style/TextAppearance.Material.Notification.Title"
                android:layout_width="44dp"
                android:layout_height="40dp"
                android:background="@drawable/hafs_live_button"
                android:gravity="center"
                android:text="+" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/hafs_done"
        style="@android:style/TextAppearance.Material.Notification.Title"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/hafs_live_button_main"
        android:gravity="center"
        android:maxLines="1"
        android:textColor="#FFFFFFFF" />
</LinearLayout>
